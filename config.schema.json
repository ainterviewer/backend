{
  "$defs": {
    "AppSecrets": {
      "properties": {
        "jwt_secret_key": {
          "format": "password",
          "title": "Jwt Secret Key",
          "type": "string",
          "writeOnly": true
        },
        "session_secret_key": {
          "format": "password",
          "title": "Session Secret Key",
          "type": "string",
          "writeOnly": true
        },
        "db_username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Db Username"
        },
        "db_password": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Db Password"
        }
      },
      "required": [
        "jwt_secret_key",
        "session_secret_key"
      ],
      "title": "AppSecrets",
      "type": "object"
    },
    "AppSettings": {
      "properties": {
        "api_host": {
          "default": "127.0.0.1",
          "title": "Api Host",
          "type": "string"
        },
        "api_port": {
          "default": 8666,
          "title": "Api Port",
          "type": "integer"
        },
        "app_host": {
          "default": "localhost",
          "title": "App Host",
          "type": "string"
        },
        "app_port": {
          "default": 5173,
          "title": "App Port",
          "type": "integer"
        },
        "web_host": {
          "default": "localhost",
          "title": "Web Host",
          "type": "string"
        },
        "web_port": {
          "default": 5174,
          "title": "Web Port",
          "type": "integer"
        },
        "public_url": {
          "default": "http://localhost:5173",
          "title": "Public Url",
          "type": "string"
        },
        "website_url": {
          "default": "http://localhost:5174",
          "title": "Website Url",
          "type": "string"
        },
        "contact_email": {
          "default": "contact@example.org",
          "title": "Contact Email",
          "type": "string"
        },
        "docs_url": {
          "default": "https://docs.ainterviewer.dk",
          "title": "Docs Url",
          "type": "string"
        },
        "jwt_interview_token_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "jwt_invite_token_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "interview_resume_link_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "jwt_auth_token_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "jwt_refresh_token_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "jwt_refresh_token_extended_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "refresh_token_reuse_grace": {
          "$ref": "#/$defs/TimeDelta"
        },
        "registration_requires_token": {
          "default": true,
          "title": "Registration Requires Token",
          "type": "boolean"
        },
        "email_verification_token_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "login_code_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "login_code_max_attempts": {
          "default": 5,
          "title": "Login Code Max Attempts",
          "type": "integer"
        },
        "password_reset_token_expiration": {
          "$ref": "#/$defs/TimeDelta"
        },
        "code_resend_cooldown_seconds": {
          "default": 30,
          "title": "Code Resend Cooldown Seconds",
          "type": "integer"
        },
        "demo_limits": {
          "$ref": "#/$defs/DemoLimits"
        },
        "last_active_debounce": {
          "$ref": "#/$defs/TimeDelta"
        }
      },
      "title": "AppSettings",
      "type": "object"
    },
    "DatabaseSettings": {
      "properties": {
        "db": {
          "$ref": "#/$defs/DatabaseType",
          "default": "sqlite"
        },
        "db_path": {
          "default": "storage",
          "title": "Db Path",
          "type": "string"
        },
        "enforce_foreign_keys": {
          "default": true,
          "title": "Enforce Foreign Keys",
          "type": "boolean"
        },
        "db_url": {
          "default": "localhost",
          "title": "Db Url",
          "type": "string"
        },
        "db_port": {
          "default": "5432",
          "title": "Db Port",
          "type": "string"
        },
        "db_name": {
          "default": "ainterviewer",
          "title": "Db Name",
          "type": "string"
        }
      },
      "title": "DatabaseSettings",
      "type": "object"
    },
    "DatabaseType": {
      "enum": [
        "sqlite",
        "postgresql"
      ],
      "title": "DatabaseType",
      "type": "string"
    },
    "DemoLimits": {
      "description": "Synthetic-interview budgets for `Scope.DEMO` accounts, counted per user.\n\nEvery synthetic interview is a full interview against the shared inference\nserver, so a demo account gets a small budget of them.\n\nThese are the defaults. The three counts can be overridden per user (the\n`user.demo_*_limit` columns, NULL meaning \"use the default\"), set by an\nadmin or snapshotted from the invitation the user registered with; see\n`UserRepository.get_demo_limits`. `active_run_max_age` is an operational\nsafeguard rather than a budget, so it stays global.",
      "properties": {
        "max_concurrent_synthetic_interviews": {
          "default": 10,
          "title": "Max Concurrent Synthetic Interviews",
          "type": "integer"
        },
        "active_run_max_age": {
          "$ref": "#/$defs/TimeDelta"
        },
        "daily_synthetic_interviews": {
          "default": 50,
          "title": "Daily Synthetic Interviews",
          "type": "integer"
        },
        "lifetime_synthetic_interviews": {
          "default": 100,
          "title": "Lifetime Synthetic Interviews",
          "type": "integer"
        }
      },
      "title": "DemoLimits",
      "type": "object"
    },
    "EmailAccount": {
      "properties": {
        "email": {
          "title": "Email",
          "type": "string"
        },
        "password": {
          "format": "password",
          "title": "Password",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "email",
        "password"
      ],
      "title": "EmailAccount",
      "type": "object"
    },
    "EmailSettings": {
      "properties": {
        "smtp_server": {
          "title": "Smtp Server",
          "type": "string"
        },
        "smtp_port": {
          "default": 587,
          "title": "Smtp Port",
          "type": "integer"
        },
        "smtp_use_ssl": {
          "default": false,
          "title": "Smtp Use Ssl",
          "type": "boolean"
        },
        "sender": {
          "$ref": "#/$defs/EmailAccount"
        },
        "recipient": {
          "$ref": "#/$defs/EmailAccount"
        }
      },
      "required": [
        "smtp_server",
        "sender",
        "recipient"
      ],
      "title": "EmailSettings",
      "type": "object"
    },
    "EmbeddingSettings": {
      "description": "Text-embedding-inference server used to vectorise interview text.\n\nDisabled by default: with `enabled = false` nothing is embedded and no\nembedder is handed to the interview loop, so a missing or unreachable\nserver changes nothing about how interviews run.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "live": {
          "default": true,
          "title": "Live",
          "type": "boolean"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "model": {
          "default": "microsoft/harrier-oss-v1-0.6b",
          "title": "Model",
          "type": "string"
        },
        "dimension": {
          "default": 1024,
          "title": "Dimension",
          "type": "integer"
        },
        "batch_size": {
          "default": 32,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_batch_chars": {
          "default": 16000,
          "title": "Max Batch Chars",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 24000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "timeout": {
          "default": 360.0,
          "title": "Timeout",
          "type": "number"
        },
        "connect_timeout": {
          "default": 5.0,
          "title": "Connect Timeout",
          "type": "number"
        },
        "max_retries": {
          "default": 3,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_retry_after": {
          "default": 30.0,
          "title": "Max Retry After",
          "type": "number"
        },
        "circuit_breaker_threshold": {
          "default": 5,
          "title": "Circuit Breaker Threshold",
          "type": "integer"
        },
        "circuit_breaker_reset_seconds": {
          "default": 60.0,
          "title": "Circuit Breaker Reset Seconds",
          "type": "number"
        }
      },
      "title": "EmbeddingSettings",
      "type": "object"
    },
    "ServiceSettings": {
      "description": "Different extra services required to run the app",
      "properties": {
        "email": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "speech": {
          "$ref": "#/$defs/SpeechSettings",
          "default": {
            "stt_model": null,
            "stt_endpoint": null,
            "sst_delay": "medium",
            "tts_model": null,
            "tts_endpoint": null,
            "tts_voice": "alloy"
          }
        },
        "embedding": {
          "$ref": "#/$defs/EmbeddingSettings",
          "default": {
            "enabled": false,
            "live": true,
            "endpoint": null,
            "model": "microsoft/harrier-oss-v1-0.6b",
            "dimension": 1024,
            "batch_size": 32,
            "max_batch_chars": 16000,
            "max_input_chars": 24000,
            "timeout": 360.0,
            "connect_timeout": 5.0,
            "max_retries": 3,
            "max_retry_after": 30.0,
            "circuit_breaker_threshold": 5,
            "circuit_breaker_reset_seconds": 60.0
          }
        }
      },
      "title": "ServiceSettings",
      "type": "object"
    },
    "SpeechSettings": {
      "properties": {
        "stt_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stt Model"
        },
        "stt_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stt Endpoint"
        },
        "sst_delay": {
          "default": "medium",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "title": "Sst Delay",
          "type": "string"
        },
        "tts_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tts Model"
        },
        "tts_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tts Endpoint"
        },
        "tts_voice": {
          "default": "alloy",
          "title": "Tts Voice",
          "type": "string"
        }
      },
      "title": "SpeechSettings",
      "type": "object"
    },
    "TimeDelta": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "default": 0,
          "title": "Days",
          "type": "integer"
        },
        "seconds": {
          "default": 0,
          "title": "Seconds",
          "type": "integer"
        },
        "microseconds": {
          "default": 0,
          "title": "Microseconds",
          "type": "integer"
        },
        "milliseconds": {
          "default": 0,
          "title": "Milliseconds",
          "type": "integer"
        },
        "minutes": {
          "default": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "hours": {
          "default": 0,
          "title": "Hours",
          "type": "integer"
        },
        "weeks": {
          "default": 0,
          "title": "Weeks",
          "type": "integer"
        }
      },
      "title": "TimeDelta",
      "type": "object"
    },
    "LLMSettings": {
      "properties": {
        "llm_host": {
          "default": "0.0.0.0",
          "title": "Llm Host",
          "type": "string"
        },
        "llm_port": {
          "default": 8880,
          "title": "Llm Port",
          "type": "integer"
        },
        "available_models": {
          "items": {
            "type": "string"
          },
          "title": "Available Models",
          "type": "array"
        },
        "default_model": {
          "default": "gpt-5-mini",
          "title": "Default Model",
          "type": "string"
        },
        "demo_models": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Demo Models"
        },
        "default_demo_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Demo Model"
        },
        "seed": {
          "default": 4268,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "LLMSettings",
      "type": "object"
    },
    "MediaStorageSettings": {
      "description": "Central configuration for all media storage.",
      "properties": {
        "base_path": {
          "default": "storage",
          "format": "path",
          "title": "Base Path",
          "type": "string"
        }
      },
      "title": "MediaStorageSettings",
      "type": "object"
    },
    "Secrets": {
      "properties": {
        "openai_api_key": {
          "default": "",
          "format": "password",
          "title": "Openai Api Key",
          "type": "string",
          "writeOnly": true
        },
        "google_ai_api_key": {
          "default": "",
          "format": "password",
          "title": "Google Ai Api Key",
          "type": "string",
          "writeOnly": true
        },
        "openrouter_api_key": {
          "default": "",
          "format": "password",
          "title": "Openrouter Api Key",
          "type": "string",
          "writeOnly": true
        },
        "vllm_api_key": {
          "default": "",
          "format": "password",
          "title": "Vllm Api Key",
          "type": "string",
          "writeOnly": true
        },
        "alex_api_key": {
          "default": "",
          "format": "password",
          "title": "Alex Api Key",
          "type": "string",
          "writeOnly": true
        }
      },
      "title": "Secrets",
      "type": "object"
    }
  },
  "properties": {
    "debug": {
      "allOf": [
        {
          "default": false,
          "title": "Debug",
          "type": "boolean"
        },
        {
          "default": false,
          "title": "Debug",
          "type": "boolean"
        }
      ]
    },
    "app_env": {
      "default": "development",
      "enum": [
        "production",
        "staging",
        "development"
      ],
      "title": "App Env",
      "type": "string"
    },
