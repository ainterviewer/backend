        "enforce_foreign_keys": true,
        "db_url": "localhost",
        "db_port": "5432",
        "db_name": "ainterviewer",
        "database_file": "db.sqlite",
        "connection_string": "sqlite:///storage/db.sqlite"
      }
    },
    "services": {
      "$ref": "#/$defs/ServiceSettings"
    },
