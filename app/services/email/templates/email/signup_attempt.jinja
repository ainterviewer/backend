{% extends "base_email.jinja" %}
{% block content %}
    <p class="main-text">
        Someone just used this email address to {{ attempt }} on <strong>AInterviewer</strong>. You already have an account with it, so nothing new was created.
    </p>
    <p class="main-text">If that was you, sign in instead:</p>
    <a href="{{ login_link }}" class="cta-button">Sign In</a>
    <p class="main-text">
        Forgotten your password? <a href="{{ reset_link }}">Reset it here</a>.
    </p>
    <p class="main-text">If it wasn't you, you can safely ignore this email; nothing has changed on your account.</p>
{% endblock %}
