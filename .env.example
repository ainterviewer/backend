# Copy to .env (git-ignored). Secrets live here or in the environment, never
# in config.toml, which refuses them.

# Required. Generate each with `openssl rand -hex 32`.
APP_SECRET__JWT_SECRET_KEY=
APP_SECRET__SESSION_SECRET_KEY=

# Required once [services.email] is configured: the sender's SMTP password.
APP_SECRET__SMTP_PASSWORD=

# Model providers (read by the ainterviewer library); each only to use its
# models, and OpenAI also for speech.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
ALEX_API_KEY=
VLLM_API_KEY=
